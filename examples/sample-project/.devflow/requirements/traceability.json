  "requirements": [
    {
      "req_id": "REQ-001",
      "title": "开通积分账户",
      "category": "functional",
      "priority": "must",
      "status": "active",
      "statement": "为指定 user_id 开通积分账户，初始 balance=0、frozen=0；同一 user_id 重复开户幂等。",
      "source": "requirements.md 三.1",
      "acceptance": [
        "重复开户不产生第二个账户",
        "新账户 balance=0、frozen=0"
      ],
      "clarification_ids": [
        "Q-101"
      ]
    },
    {
      "req_id": "REQ-002",
      "title": "每日签到送积分",
      "category": "functional",
      "priority": "must",
      "status": "active",
      "statement": "每个自然日首次签到发放 10 积分，当天重复签到不重复入账。",
      "source": "requirements.md 三.2",
      "acceptance": [
        "当天首次签到余额 +10",
        "当天第二次签到余额与流水均不变"
      ],
      "clarification_ids": [
        "Q-103"
      ]
    },
    {
      "req_id": "REQ-003",
      "title": "订单完成奖励积分",
      "category": "business_rule",
      "priority": "must",
      "status": "active",
      "statement": "1 元 = 1 积分，按实付金额（分）整除 100 向下取整；同一订单号幂等。",
      "source": "requirements.md 三.3 + Q-001",
      "acceptance": [
        "1999 分奖励 19 分",
        "同一订单号只入账一次",
        "不足 1 元不入账"
      ],
      "clarification_ids": [
        "Q-001"
      ]
    },
    {
      "req_id": "REQ-004",
      "title": "兑换扣减积分",
      "category": "functional",
      "priority": "must",
      "status": "active",
      "statement": "兑换时按可用积分（balance - frozen）校验；不足则拒绝且无副作用。",
      "source": "requirements.md 三.4 + CR-001",
      "acceptance": [
        "可用不足无副作用",
        "允许扣到 0，不允许为负",
        "冻结后按新可用额度校验"
      ],
      "clarification_ids": [
        "Q-003"
      ]
    },
    {
      "req_id": "REQ-005",
      "title": "积分流水记录与查询",
      "category": "functional",
      "priority": "must",
      "status": "active",
      "statement": "每笔变动记录 amount（余额变动）与 frozen_delta（冻结变动）、来源单号、时间；分页默认 20、最大 100。",
      "source": "requirements.md 三.5 + CR-001",
      "acceptance": [
        "每笔变动有且只有一条流水",
        "分页 size 超 100 截断",
        "两条对账公式成立"
      ],
      "clarification_ids": [
        "Q-102"
      ]
    },
    {
      "req_id": "REQ-006",
      "title": "余额查询",
      "category": "functional",
      "priority": "must",
      "status": "active",
      "statement": "返回 balance、frozen、available，available = balance - frozen。",
      "source": "requirements.md 三.6 + CR-001",
      "acceptance": [
        "available = balance - frozen",
        "不存在的用户抛 AccountNotFound"
      ],
      "clarification_ids": []
    },
    {
      "req_id": "REQ-007",
      "title": "运营查询全部流水",
      "category": "permission",
      "priority": "should",
      "status": "active",
      "statement": "运营可按 user_id 或时间区间查询全部用户流水。",
      "source": "requirements.md 二",
      "acceptance": [
        "不传 user_id 返回全部",
        "时间区间左闭右开"
      ],
      "clarification_ids": [
        "OPEN-003"
      ]
    },
    {
      "req_id": "REQ-008",
      "title": "并发安全与数据原子性",
      "category": "non_functional",
      "priority": "must",
      "status": "active",
      "statement": "并发扣减/冻结不得超扣、不得超冻；写盘原子；积分全程整数运算。",
      "source": "requirements.md 五 + Q-003",
      "acceptance": [
        "20 线程各扣 1 分恰好 10 次成功",
        "20 线程各冻结 1 分恰好 10 次成功",
        "落盘原子",
        "不出现 float"
      ],
      "clarification_ids": [
        "Q-003"
      ]
    },
    {
      "req_id": "REQ-009",
      "title": "积分冻结与解冻",
      "category": "business_rule",
      "priority": "must",
      "status": "active",
      "statement": "退款时冻结等额积分：balance 不变、frozen 增加、available 减少；运营可解冻。冻结与解冻各写一条流水（frozen_delta）。",
      "source": ".devflow/changes/CR-001/change-request.md",
      "acceptance": [
        "冻结后 balance 不变、available 减少",
        "冻结后兑换按新 available 校验",
        "允许部分解冻，解冻后 available 恢复",
        "sum(frozen_delta) == frozen"
      ],
      "clarification_ids": [
        "Q-004"
      ]
    }
  ]
}
