{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/change.schema.json",
  "title": "DevFlow 需求变更记录（change-request.json）",
  "type": "object",
  "required": [
    "change_id",
    "title",
    "type",
    "status",
    "base_requirement_version",
    "base_plan_version",
    "impacts"
  ],
  "properties": {
    "change_id": { "type": "string", "pattern": "^CR-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["add", "modify", "remove", "rule_change", "data_change", "tech_change", "nfr_change", "external_change"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "confirmed", "applied", "rejected"],
      "description": "draft=影响评估中；confirmed=用户已确认；applied=已生成并启用新版计划"
    },
    "requested_by": { "type": "string" },
    "requested_at": { "type": "string" },
    "base_requirement_version": { "type": "integer", "minimum": 1 },
    "base_plan_version": {
      "type": "integer",
      "minimum": 0,
      "description": "基线计划版本；0 表示提出变更时项目还没有生效计划"
    },
    "target_requirement_version": { "type": ["integer", "null"] },
    "target_plan_version": { "type": ["integer", "null"] },
    "description": { "type": "string" },
    "reason": { "type": "string" },
    "old_behavior": { "type": "string" },
    "new_behavior": { "type": "string" },
    "requirement_ids": { "type": "array", "items": { "type": "string" } },
    "impacts": {
      "type": "array",
      "description": "影响评估结果；status=confirmed 时必须非空（由 change-apply 校验）",
      "items": {
        "type": "object",
        "required": ["node_id", "action", "reason"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^DF-[0-9]{3,}$" },
          "action": {
            "type": "string",
            "enum": ["reusable", "modify", "add", "deprecate", "review"]
          },
          "reason": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "requires_retest": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "items": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "recommended_plan": { "type": "string" },
    "confirmed_at": { "type": ["string", "null"] },
    "confirmed_by": { "type": ["string", "null"] },
    "applied_at": {
      "type": ["string", "null"],
      "description": "change-apply 提交成功的时间；status=applied 时必填"
    }
  },
  "additionalProperties": false
}
