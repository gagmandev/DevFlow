{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/node.schema.json",
  "title": "DevFlow 任务节点",
  "type": "object",
  "required": [
    "node_id",
    "node_name",
    "phase",
    "type",
    "priority",
    "description",
    "requirement_ids",
    "dependencies",
    "parallelizable",
    "acceptance_criteria",
    "inputs",
    "outputs",
    "files_scope",
    "test_strategy",
    "status",
    "prompt_file"
  ],
  "properties": {
    "node_id": { "type": "string", "pattern": "^DF-[0-9]{3,}$" },
    "node_name": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "enum": ["Foundation", "Shared", "Business", "Integration", "Release"]
    },
    "type": {
      "type": "string",
      "enum": ["infrastructure", "shared", "business", "integration", "release"]
    },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "description": { "type": "string", "minLength": 1 },
    "requirement_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DF-[0-9]{3,}$" },
      "description": "前置节点 ID；必须全部 completed 本节点才可执行"
    },
    "parallelizable": { "type": "boolean" },
    "parallel_group": { "type": ["string", "null"] },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "inputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "必须阅读的文件/产物，相对项目根目录"
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "交付物（文件或能力），相对项目根目录"
    },
    "files_scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "允许修改的文件/目录范围；空数组表示仅允许新增 outputs 中列出的文件"
    },
    "db_objects": {
      "type": "array",
      "items": { "type": "string" },
      "description": "涉及的表/集合/迁移脚本标识；同一并行组内不允许重复"
    },
    "api_contracts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "涉及修改的接口契约标识；同一并行组内不允许重复"
    },
    "shared_config": {
      "type": "array",
      "items": { "type": "string" },
      "description": "涉及的共享配置项；同一并行组内不允许重复"
    },
    "test_strategy": {
      "type": "array",
      "items": { "type": "string" },
      "description": "测试方案：要覆盖的场景与命令"
    },
    "no_test": {
      "type": "boolean",
      "default": false,
      "description": "true 表示该节点确实无需自动化测试（如纯文档），必须同时给出 no_test_reason"
    },
    "no_test_reason": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "in_progress",
        "needs_review",
        "completed",
        "blocked",
        "failed",
        "superseded",
        "cancelled"
      ]
    },
    "prompt_file": { "type": "string" },
    "context_file": { "type": ["string", "null"] },
    "execution_report": { "type": ["string", "null"] },
    "test_report": { "type": ["string", "null"] },
    "owner": { "type": ["string", "null"] },
    "attempts": { "type": "integer", "minimum": 0, "default": 0 },
    "current_attempt_id": {
      "type": ["string", "null"],
      "description": "本轮执行的唯一标识；执行报告与测试报告必须回填同一个值"
    },
    "attempt_number": { "type": ["integer", "null"], "minimum": 1 },
    "prompt_version": {
      "type": "integer",
      "minimum": 0,
      "description": "提示词版本；每次 prompt-init 递增"
    },
    "deliverables": {
      "type": ["object", "null"],
      "description": "accept 时记录的交付物指纹；下游用它判断依赖产物是否被改过",
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sha256": { "type": "string" },
              "size": { "type": "integer" },
              "mtime": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "plan_version": { "type": ["integer", "null"] },
        "recorded_at": { "type": "string" },
        "git_head": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "context_acks": {
      "type": "array",
      "description": "依赖产物变更后，主控确认「不影响本节点」的记录",
      "items": {
        "type": "object",
        "required": ["reason", "at"],
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "at": { "type": "string" },
          "changes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "git_baseline": {
      "type": ["object", "null"],
      "description": "start 时记录的 Git 基准：head、已有未提交文件",
      "properties": {
        "head": { "type": ["string", "null"] },
        "dirty_files": { "type": "array", "items": { "type": "string" } },
        "captured_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "git_actual_changes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "sync 时检测到的实际变更（已排除执行前就存在的修改）"
    },
    "git_discrepancies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "实际变更与 modified_files 的差异；非空需要人工确认"
    },
    "git_waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "at"],
        "properties": {
          "reason": { "type": "string" },
          "at": { "type": "string" },
          "by": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "description": "人工确认 Git 差异的记录"
    },
    "scope_violations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "最近一次同步发现的越界修改；非空时禁止验收"
    },
    "scope_waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "at"],
        "properties": {
          "reason": { "type": "string" },
          "at": { "type": "string" },
          "by": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "description": "主控确认放行的越界记录（必须写理由）"
    },
    "started_at": { "type": ["string", "null"] },
    "completed_at": { "type": ["string", "null"] },
    "accepted_by": { "type": ["string", "null"] },
    "created_in_plan": { "type": ["integer", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "blocked_reason": { "type": ["string", "null"] },
    "remark": { "type": "string" }
  },
  "additionalProperties": false
}
