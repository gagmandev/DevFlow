{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/requirements.schema.json",
  "title": "DevFlow 需求追踪表（traceability.json）",
  "type": "object",
  "required": ["schema_version", "requirement_version", "requirements"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "requirement_version": { "type": "integer", "minimum": 1 },
    "source_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "原始需求文件路径（只读，不修改）"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["req_id", "title", "category", "status"],
        "properties": {
          "req_id": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "functional",
              "non_functional",
              "business_rule",
              "data",
              "integration",
              "permission",
              "constraint",
              "acceptance"
            ]
          },
          "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
          "status": {
            "type": "string",
            "enum": ["active", "changed", "removed", "deferred"],
            "description": "changed/removed 只在需求变更时使用，旧条目保留"
          },
          "statement": { "type": "string" },
          "source": { "type": "string", "description": "来源：文件名+章节/页码/图号" },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "clarification_ids": { "type": "array", "items": { "type": "string" } },
          "superseded_by": { "type": ["string", "null"] },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
