{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/requirements.schema.json",
  "title": "DevFlow 需求追踪表（traceability.json）",
  "type": "object",
  "required": ["schema_version", "requirement_version", "requirements"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "requirement_version": { "type": "integer", "minimum": 1 },
    "source_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "原始需求文件路径（只读，不修改）"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["req_id", "title", "category", "status"],
        "properties": {
          "req_id": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "functional",
              "non_functional",
              "business_rule",
              "data",
              "integration",
              "permission",
              "constraint",
              "acceptance"
            ]
          },
          "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
          "status": {
            "type": "string",
            "enum": ["active", "changed", "removed", "deferred", "out_of_scope"],
            "description": "非 active 状态必须有 reason 与 confirmed_by，防止用改状态绕过覆盖检查"
          },
          "reason": { "type": "string", "description": "为什么 deferred / out_of_scope / removed" },
          "confirmed_by": { "type": ["string", "null"], "description": "谁确认了范围调整" },
          "confirmed_at": { "type": ["string", "null"] },
          "statement": { "type": "string" },
          "source": { "type": "string", "description": "来源：文件名+章节/页码/图号" },
          "acceptance": {
            "type": "array",
            "description": "验收标准。字符串为旧格式；对象可带稳定 id，便于与执行证据逐条对应",
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "required": ["criterion"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^AC-[0-9A-Za-z._-]+$" },
                    "criterion": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "clarification_ids": { "type": "array", "items": { "type": "string" } },
          "superseded_by": { "type": ["string", "null"] },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
