{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/backlog.schema.json",
  "title": "DevFlow 任务计划（版本化）",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "plan_version",
    "requirement_version",
    "status",
    "created_at",
    "nodes"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "plan_version": { "type": "integer", "minimum": 1 },
    "requirement_version": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "superseded", "rejected"],
      "description": "draft=待人工审核；active=当前生效；superseded=已被新版取代"
    },
    "created_at": { "type": "string" },
    "approved_at": { "type": ["string", "null"] },
    "approved_by": { "type": ["string", "null"] },
    "based_on": {
      "type": ["object", "null"],
      "properties": {
        "plan_version": { "type": "integer", "minimum": 1 },
        "change_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "stats_note": { "type": "string" },
    "parallel_exceptions": {
      "type": "array",
      "description": "人工确认的并行例外；没有记录就不能把冲突节点放进同一并行组",
      "items": {
        "type": "object",
        "required": ["group", "nodes", "reason", "approved_by"],
        "properties": {
          "group": { "type": "string" },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" },
            "description": "必须点名冲突的节点组合，不允许整组豁免"
          },
          "reason": { "type": "string", "minLength": 1 },
          "approved_by": { "type": "string", "minLength": 1 },
          "at": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "node.schema.json" }
    }
  },
  "additionalProperties": false
}
